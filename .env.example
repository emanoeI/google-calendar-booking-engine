# Environment & CORS
APP_ENV=development
APP_ORIGIN=http://localhost:5173

# Google Calendar Integration (Service Account)
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_CREDENTIALS_PATH=/absolute/path/to/service-account.json

# Bot Protection (Optional - Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=

# Business Contact (Used for client redirect URL after booking)
BUSINESS_WHATSAPP=5511999999999

# Runtime Locks & Rate Limiting (Leave empty to use system temp)
BOOKING_LOCK_PATH=
BOOKING_RATE_LIMIT_PATH=
